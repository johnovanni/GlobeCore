<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No UI, so no-UI projects (an app's .Core) can use the Earth body and assets. Decoding the Blue Marble needs WPF
         imaging, so the WPF side does it: ImageConversions.DecodeToBgra32(EarthAssets.Open(EarthAssets.BlueMarbleFile), width). -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GlobeCore.Earth</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resource names: GlobeCore.Earth.Assets.<file>. -->
    <EmbeddedResource Include="Assets\**" Exclude="Assets\README.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlobeCore\GlobeCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GlobeCore.Tests" />
    <InternalsVisibleTo Include="EarthWatch3D.Tests" />
    <InternalsVisibleTo Include="EarthRelief3D.Tests" />
  </ItemGroup>

</Project>
